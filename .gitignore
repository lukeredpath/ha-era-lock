# Python
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local HA dev environment (never commit a running config, its storage, or the
# machine-specific component symlink — dev/README.md documents how to recreate it)
dev/.venv/
dev/dev-config/

# Secrets must never live in this public repo (defensive — they belong in the
# HA config entry at runtime, never in source)
*secrets.json
era_keychain.json
*.kcpass
lock_state.json

# Archive dir (never delete; move here)
.deleted/
